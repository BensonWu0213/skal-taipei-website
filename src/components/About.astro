---
import { about } from "@/data/site";
---

<section class="section tight" id="about" aria-labelledby="about-title">
  <div class="container">
    <div class="mast">
      <span class="no">{about.no}</span>
      <h2 id="about-title">{about.title}</h2>
      <span class="aside">{about.aside}</span>
    </div>
    <div class="about-cols">
      {about.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <dl class="ledger">
      {
        about.stats.map((s) => (
          <div>
            <dt class="num">
              {s.value}
              {s.sup && <sup>{s.sup}</sup>}
            </dt>
            <dd>{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .about-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 3vw, 48px); }
  .about-cols p { font-size: 16.5px; line-height: 1.7; }
  .about-cols p:first-child::first-letter { font-family: var(--font-display); font-size: 3.4em; float: left; line-height: 0.82; padding: 6px 10px 0 0; color: var(--fg); }
  .ledger { margin: clamp(40px, 5vw, 72px) 0 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--fg); }
  .ledger div { padding: 22px 0 6px; }
  .ledger div + div { border-left: 1px solid var(--border); padding-left: 22px; }
  .ledger dt { font-family: var(--font-display); font-size: clamp(40px, 5vw, 76px); line-height: 0.95; letter-spacing: -0.03em; }
  .ledger dt sup { font-size: 0.4em; color: var(--accent-ink); vertical-align: top; top: 0.3em; position: relative; }
  .ledger dd { margin: 10px 0 0; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  @media (max-width: 920px) {
    .about-cols { grid-template-columns: 1fr; }
    .ledger { grid-template-columns: 1fr 1fr; }
    .ledger div:nth-child(3) { border-left: 0; padding-left: 0; }
    .ledger div:nth-child(n + 3) { border-top: 1px solid var(--border); }
  }
</style>
