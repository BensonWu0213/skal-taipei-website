---
import { Image } from "astro:assets";
import { events } from "@/data/site";
import { getEventCards } from "@/lib/feed";

const cards = getEventCards(events.count);
const slotClass = (i: number) => (i === 0 ? "lead-story" : i === 1 ? "second" : i === 2 ? "third" : "small");
// Rendered widths per slot (design widths at 1280 container).
const slotSizes = (i: number) =>
  i === 0
    ? "(max-width: 1024px) 100vw, 720px"
    : i < 3
      ? "(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 520px"
      : "(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px";
---

<section class="section tight" id="events" aria-labelledby="events-title">
  <div class="container">
    <div class="mast">
      <span class="no">{events.no}</span>
      <h2 id="events-title">{events.title}</h2>
      <a class="rss" href="/feed.xml" aria-label="Subscribe to the RSS feed">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <circle cx="5" cy="19" r="2.2" />
          <path d="M3 10.5a10.5 10.5 0 0 1 10.5 10.5h-3A7.5 7.5 0 0 0 3 13.5z" />
          <path d="M3 4a17 17 0 0 1 17 17h-3A14 14 0 0 0 3 7z" />
        </svg>
        {events.rssLabel}
      </a>
    </div>

    <div class="ev-grid">
      {
        cards.map((card, i) => (
          <article class:list={["ev", slotClass(i)]} data-post-id={card.id}>
            {card.image ? (
              <a
                class:list={["ev-media", { contain: card.portrait }]}
                href={card.url}
                target="_blank"
                rel="noopener"
                tabindex="-1"
                aria-hidden="true"
              >
                <Image
                  src={card.image}
                  widths={i === 0 ? [640, 960, 1440] : [480, 800, 1040]}
                  sizes={slotSizes(i)}
                  alt=""
                  loading={i === 0 ? "eager" : "lazy"}
                />
              </a>
            ) : (
              <div class="ev-media none" aria-hidden="true">
                <div class="mark">
                  <svg viewBox="0 0 34 40">
                    <path d="M2 2h30v22c0 8-7 13-15 16C9 37 2 32 2 24Z" fill="none" stroke="currentColor" stroke-width="1.4" />
                  </svg>
                  <span>{events.emptyMark}</span>
                </div>
              </div>
            )}
            <div class="ev-meta">
              <time class="meta" datetime={card.dateISO}>{card.dateLabel}</time>
              {card.tag && <span class="tag">{card.tag}</span>}
            </div>
            <h3>{card.title}</h3>
            <p>{card.summary}</p>
            <a class="ev-link" href={card.url} target="_blank" rel="noopener">
              {events.readMore}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
              <span class="visually-hidden">: {card.title} (opens in a new tab)</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .mast .rss { grid-column: 3; justify-self: end; margin-bottom: 4px; }
  .rss { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 12px; border: 1px solid var(--fg); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg); }
  .rss:hover { background: var(--fg); color: var(--on-navy); }
  .rss svg { width: 15px; height: 15px; }
  @media (max-width: 720px) { .mast .rss { grid-column: 1; justify-self: start; } }

  .ev-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(20px, 2.5vw, 40px) clamp(16px, 2vw, 32px); }
  .ev { display: flex; flex-direction: column; gap: 12px; border-top: 1px solid var(--fg); padding-top: 16px; }
  .ev.lead-story { grid-column: span 7; grid-row: span 2; }
  .ev.second, .ev.third { grid-column: span 5; }
  .ev.small { grid-column: span 4; }
  .ev-media { display: block; overflow: hidden; background: var(--fg-soft); }
  .ev-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .ev:hover .ev-media img { transform: scale(1.02); }
  .lead-story .ev-media { aspect-ratio: 4 / 3; }
  .second .ev-media, .third .ev-media { aspect-ratio: 3 / 2; }
  .small .ev-media { aspect-ratio: 16 / 10; }
  .ev-media.contain { background: var(--fg); }
  .ev-media.contain img { object-fit: contain; }
  .ev-media.none { display: grid; place-items: center; background: var(--fg); color: var(--accent); }
  .ev-media.none .mark { display: grid; place-items: center; gap: 8px; text-align: center; }
  .ev-media.none .mark svg { width: 36px; height: 44px; }
  .ev-media.none .mark span { font-family: var(--font-display); font-style: italic; font-size: 20px; color: var(--on-navy); }
  .ev-meta { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .ev-meta .tag { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-ink); border: 1px solid var(--accent-ink); padding: 2px 8px; }
  .ev h3 { font-size: 22px; }
  .lead-story h3 { font-size: clamp(28px, 3vw, 42px); font-weight: 400; letter-spacing: -0.015em; }
  .ev p { color: var(--muted); font-size: 15px; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .lead-story p { font-size: 17px; -webkit-line-clamp: 3; line-clamp: 3; }
  .ev-link { margin-top: auto; display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg); min-height: 32px; border-bottom: 1px solid transparent; align-self: flex-start; }
  .ev-link:hover { border-bottom-color: var(--fg); }
  .ev-link svg { width: 14px; height: 14px; transition: transform .15s; }
  .ev-link:hover svg { transform: translateX(3px); }
  @media (max-width: 1024px) {
    .ev.lead-story { grid-column: span 12; grid-row: auto; }
    .ev.second, .ev.third, .ev.small { grid-column: span 6; }
  }
  @media (max-width: 640px) {
    .ev.second, .ev.third, .ev.small { grid-column: span 12; }
    .lead-story h3 { font-size: 30px; }
  }
</style>
