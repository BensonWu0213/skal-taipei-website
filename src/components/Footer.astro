---
import { contact, site } from "@/data/site";
---

<footer class="contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact-grid">
      <h2 id="contact-title">{contact.title.lead} <em>{contact.title.em}</em></h2>
      <div class="contact-list">
        {
          contact.links.map((l) => (
            <a href={l.href} target={l.external ? "_blank" : undefined} rel={l.external ? "noopener" : undefined}>
              <span class="lbl">{l.label}</span>
              <span class="val">{l.value}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M7 17 17 7M9 7h8v8" />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
    <div class="footbar">
      <a href={site.global} target="_blank" rel="noopener" aria-label="Skål International (opens in a new tab)">
        <img
          class="global-logo"
          src="/images/brand/skal-international-logo-white.svg"
          width="658"
          height="340"
          alt=""
          loading="lazy"
        />
      </a>
      <div class="footbar-links">
        <span>{contact.copyright}</span>
        <a href="/feed.xml">RSS</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .contact { background: var(--navy-deep); color: var(--on-navy); padding-top: clamp(56px, 8vw, 104px); }
  .contact h2 { font-size: clamp(40px, 7vw, 110px); line-height: 0.95; letter-spacing: -0.03em; max-width: 12ch; }
  .contact h2 em { font-style: italic; color: var(--accent); }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(32px, 5vw, 80px); align-items: end; padding-bottom: clamp(40px, 6vw, 72px); border-bottom: 1px solid oklch(0.97 0.006 70 / 0.3); }
  .contact-list a { display: grid; grid-template-columns: 90px 1fr auto; gap: 16px; align-items: center; padding: 16px 0; border-top: 1px solid oklch(0.97 0.006 70 / 0.2); min-height: 56px; }
  .contact-list a:last-child { border-bottom: 1px solid oklch(0.97 0.006 70 / 0.2); }
  .contact-list .lbl { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .contact-list .val { font-size: 16px; color: var(--on-navy); word-break: break-word; }
  .contact-list svg { width: 16px; height: 16px; color: var(--on-navy-muted); transition: transform .15s; }
  .contact-list a:hover svg { transform: translate(2px, -2px); color: var(--accent); }
  .contact-list a:hover .val { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--accent); }
  .footbar { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; padding: 24px 0 32px; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-navy-muted); }
  .footbar .global-logo { height: 56px; width: auto; }
  .footbar-links { display: flex; gap: 22px; flex-wrap: wrap; }
  .footbar-links a:hover { color: var(--on-navy); text-decoration: underline; text-underline-offset: 4px; }
  .contact :focus-visible { outline-color: var(--on-navy); }
  @media (max-width: 920px) { .contact-grid { grid-template-columns: 1fr; align-items: start; } }
  @media (max-width: 480px) {
    .contact-list a { grid-template-columns: 70px 1fr auto; }
    .contact-list .val { font-size: 14.5px; }
  }
</style>
