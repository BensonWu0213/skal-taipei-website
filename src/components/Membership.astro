---
import { membership } from "@/data/site";
---

<section class="section tight" id="membership" aria-labelledby="membership-title">
  <div class="container">
    <div class="mast">
      <span class="no">{membership.no}</span>
      <h2 id="membership-title">{membership.title}</h2>
      <span class="aside">{membership.aside}</span>
    </div>
    <div class="member-grid">
      <div class="who">
        <h3>{membership.whoTitle}</h3>
        <p>{membership.who}</p>
        <ul class="sectors" aria-label="Sectors represented">
          {membership.sectors.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div>
        <ol class="steps">
          {
            membership.steps.map((step, i) => (
              <li class="step">
                <span class="n" aria-hidden="true">{i + 1}</span>
                <div>
                  <h4>{step.title}</h4>
                  <p>{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="fee">
          <p><strong>Membership fees:</strong> {membership.feeNote}</p>
          <a class="btn btn-secondary" href={membership.cta.href}>{membership.cta.label}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .member-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .who h3 { font-size: 26px; font-weight: 400; margin-bottom: 12px; }
  .who p { color: var(--muted); line-height: 1.65; }
  .sectors { display: flex; flex-wrap: wrap; gap: 6px; margin: 18px 0 0; padding: 0; list-style: none; }
  .sectors li { padding: 6px 10px; border: 1px solid var(--fg); font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; }
  .steps { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--fg); }
  .step { display: grid; grid-template-columns: 64px 1fr; gap: 20px; padding: 24px 0; border-bottom: 1px solid var(--border); }
  .step .n { font-family: var(--font-display); font-size: 40px; line-height: 1; }
  .step h4 { font-family: var(--font-body); font-size: 18px; font-weight: 600; letter-spacing: -0.005em; }
  .step p { color: var(--muted); margin-top: 6px; font-size: 15px; line-height: 1.6; }
  .fee { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 16px 28px; align-items: center; justify-content: space-between; }
  .fee p { font-size: 15px; color: var(--muted); max-width: 40ch; }
  .fee p strong { color: var(--fg); }
  @media (max-width: 920px) { .member-grid { grid-template-columns: 1fr; } }
</style>
