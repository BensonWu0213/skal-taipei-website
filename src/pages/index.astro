---
import Base from "@/layouts/Base.astro";
import TopNav from "@/components/TopNav.astro";
import Hero from "@/components/Hero.astro";
import About from "@/components/About.astro";
import Events from "@/components/Events.astro";
import Programmes from "@/components/Programmes.astro";
import WhyJoin from "@/components/WhyJoin.astro";
import Membership from "@/components/Membership.astro";
import Footer from "@/components/Footer.astro";
---

<Base>
  <a class="skip" href="#main">Skip to content</a>
  <TopNav />
  <main id="main">
    <span id="top"></span>
    <Hero />
    <About />
    <Events />
    <Programmes />
    <WhyJoin />
    <Membership />
  </main>
  <Footer />
</Base>

<style>
  .skip { position: absolute; left: 12px; top: -100px; z-index: 100; background: var(--fg); color: var(--on-navy); padding: 10px 16px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
  .skip:focus { top: 12px; }
</style>
